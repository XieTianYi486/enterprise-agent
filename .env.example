# ============================================================
# 企业办公 Agent - 环境配置模板
# 复制为 .env 后填入真实值
# ============================================================

# --- 应用基础 ---
APP_NAME=企业办公 Agent
DEBUG=true
HOST=0.0.0.0
PORT=8002

# --- 数据库（默认 SQLite，零配置）---
DATABASE_URL=sqlite:///./data/agent.db

# --- 阿里云百炼（DashScope）---
# 必填！从 https://dashscope.console.aliyun.com/ 获取
DASHSCOPE_API_KEY=your-api-key-here
DASHSCOPE_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# --- Agent 护栏（简历亮点：可控性）---
AGENT_MAX_TURNS=8
AGENT_TIMEOUT_SECONDS=60
# 写操作（提交请假/报销）是否强制用户二次确认
WRITE_CONFIRMATION_ENABLED=true
MAX_HISTORY_MESSAGES=30

# --- 认证 ---
AUTH_ENABLED=true
# 生产必须换强随机值：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- 演示账号（首次启动自动创建）---
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123456